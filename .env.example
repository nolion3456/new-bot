# Required
DISCORD_TOKEN=your_discord_bot_token

# Optional: comma/space/semicolon-separated server IDs for immediate slash-command registration.
# These servers receive all commands through Guild registration first; other servers use global sync.
DISCORD_GUILD_IDS=

# Legacy single-server alias; DISCORD_GUILD_IDS is preferred.
DISCORD_GUILD_ID=

# Optional: channel that receives welcome messages
WELCOME_CHANNEL_ID=

# Optional: HTTP port used by Render health checks
PORT=10000

# Optional: member IDs that automatically claim red packets in this order.
# Separate multiple IDs with commas or spaces. This feature is env-only and has no slash command.
REDPACKET_AUTO_CLAIM_USER_IDS=

# Optional: limit automatic red-packet claiming to one server.
REDPACKET_AUTO_CLAIM_GUILD_ID=
